# Copy this file to .env and fill in your keys.

# NVIDIA Build key (nvapi-...), generated at build.nvidia.com. One key covers every model.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

# VirusTotal API key (free account at virustotal.com -> profile -> API key). Optional.
VT_API_KEY=f91bf45769931e560e3e6f2a62af365b00ed417082f32869dad519a0399e50d2

PORT=3000
# 127.0.0.1 = only this PC can reach the hub (and your keys). Keep it that way.
HOST=127.0.0.1
