# Copy this file to .env and fill in your keys.  (Windows: copy .env.example .env)

# --- NVIDIA Build key (nvapi-...), generated at build.nvidia.com. One key covers every model.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

# --- VirusTotal key (free account at virustotal.com > profile > API key). Optional.
VT_API_KEY=

# --- Server. 127.0.0.1 = only this PC can reach the hub directly. Keep it that way:
#     tunnels / Tailscale connect from this same PC, so they work with 127.0.0.1.
PORT=3000
HOST=127.0.0.1

# --- Family login with Clerk (optional). Leave both empty = no login, single local user.
#     Needs:  npm install @clerk/express      (see HOSTING.md for the full setup)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Your own Clerk user id (user_...). Sign in once, then copy it from Settings > Account.
ADMIN_USER_IDS=
# Optional extra safety net: only these ids (plus admins) may use the hub. Empty = any signed-in user.
ALLOWED_USER_IDS=
# Host names the hub answers to besides localhost, e.g. your tunnel or Tailscale name (comma separated).
ALLOWED_HOSTS=

# --- Limits for non-admin accounts (the NVIDIA and VirusTotal keys are shared by everyone)
USER_CHAT_PER_MIN=10
USER_VT_PER_DAY=60

# --- Background model checks (one tiny request per model at startup, then every N minutes)
HEALTH_ENABLED=1
HEALTH_INTERVAL_MIN=5
